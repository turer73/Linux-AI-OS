# Linux-AI Environment Variables
# Copy this file to .env and fill in your tokens
# NEVER commit .env to git!

# --- Ollama (Local AI) ---
OLLAMA_NUM_GPU=0                    # 0 = CPU-only (GT 330M has no CUDA)
OLLAMA_NUM_THREAD=4                 # Match CPU thread count
OLLAMA_MAX_LOADED_MODELS=1          # RAM constraint (8 GB)

# --- Vercel ---
# Get token: https://vercel.com/account/tokens
VERCEL_TOKEN=

# --- Cloudflare ---
# Get token: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone:Read, Zone:Edit, Analytics:Read, Cache Purge
CLOUDFLARE_API_TOKEN=

# --- Supabase ---
# Get token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Fal.ai ---
# Get key: https://fal.ai/dashboard/keys
FAL_KEY=

# --- HuggingFace ---
# Get token: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# --- Coolify (Self-hosting) ---
# Get token: Coolify Dashboard -> Keys & Tokens -> API tokens
# API base: http://<your-server-ip>:8000/api/v1
COOLIFY_API_TOKEN=
COOLIFY_API_BASE=http://localhost:8000/api/v1

# --- Notifications (ai-monitor) ---
# Telegram: @BotFather -> /newbot -> get token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- GitHub ---
# gh CLI uses its own auth: gh auth login
# Or set: https://github.com/settings/tokens
GITHUB_TOKEN=
